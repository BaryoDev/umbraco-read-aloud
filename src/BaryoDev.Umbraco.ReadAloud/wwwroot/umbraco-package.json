{
  "$schema": "../../umbraco-package-schema.json",
  "id": "BaryoDev.ReadAloud",
  "name": "BaryoDev.ReadAloud",
  "version": "0.2.1",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "BaryoDev.ReadAloud.Dashboard",
      "name": "Read Aloud",
      "element": "/App_Plugins/BaryoDev.ReadAloud/dashboard.js",
      "weight": 10,
      "meta": {
        "label": "Read Aloud",
        "pathname": "read-aloud"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    },
    {
      "type": "propertyEditorUi",
      "alias": "BaryoDev.ReadAloud.VoicePicker",
      "name": "Read Aloud voice picker",
      "element": "/App_Plugins/BaryoDev.ReadAloud/voice-picker.js",
      "meta": {
        "label": "Read Aloud voice",
        "icon": "icon-sound-waves",
        "group": "pickers",
        "propertyEditorSchemaAlias": "Umbraco.Plain.String"
      }
    }
  ]
}
