// Settings for the deployed public demo only. They live here rather than in appsettings.json
// because the test fixture boots this same host, and it boots it in Development: an allow-list
// here would silently change what the endpoint tests are asserting, since several of them turn on
// AllowedVoices being empty, which is what a site that configures nothing has.
{
  "Umbraco": {
    "CMS": {
      "ModelsBuilder": {
        // The published image carries no Razor runtime compiler, because Umbraco only pulls
        // Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation in through its development mode
        // package. The default InMemoryAuto mode needs one, so the demo asks for no models at all
        // and its single view is compiled into the image instead.
        "ModelsMode": "Nothing"
      }
    }
  },
  "BaryoDev": {
    "ReadAloud": {
      // Four voices so a visitor can hear that ?voice= is honoured, and hear that a voice which
      // is not on this list falls back to the default rather than being passed through.
      "AllowedVoices": [
        "en-GB-SoniaNeural",
        "en-US-JennyNeural",
        "en-AU-NatashaNeural",
        "fil-PH-BlessicaNeural"
      ],
      // Inside the mounted volume on purpose, so a release does not throw away audio that has
      // already been synthesized and make every visitor pay for the cold path again.
      "CachePath": "umbraco/Data/ReadAloudCache"
    }
  }
}
